# ---- Application ----
APP_ENV=development            # development | test | production
APP_NAME=Sales Lead Qualification Agent
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Database ----
# Local lightweight mode:
DATABASE_URL=sqlite:///./data/app.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://sla:CHANGE_ME@db:5432/sla

# ---- Security ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_MINUTES=60
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# First admin is created by `python -m scripts.create_admin` (never hard-coded).

# ---- Gemini (AI qualification) ----
# LLM_PROVIDER=disabled keeps the app fully working with deterministic scoring only.
LLM_PROVIDER=        # disabled | gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash  # read from env; check Google's current model list
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=6000

# ---- Optional company research (Brave Search API, official API) ----
RESEARCH_ENABLED=false
SEARCH_PROVIDER=brave
BRAVE_API_KEY=

# ---- Workflow ----
WORKFLOW_INLINE=false          # true = run workflow inside the request (useful for debugging)
WORKFLOW_STALE_MINUTES=15
CSV_MAX_BYTES=2000000
CSV_MAX_ROWS=2000

# ---- Feature flags ----
EMAIL_SENDING_ENABLED=false    # drafts only in v1; sending is intentionally not implemented
ENABLE_DOCS=true               # set false behind public ingress if you do not want /api/v1/docs exposed
